# Copy this file to .env and fill in real values before running locally or deploying.

# Flask secret key used to sign session cookies (generate a random string for production)
SECRET_KEY=change-this-to-a-random-secret

# Database connection string.
# Local default (SQLite, no setup needed):
#   sqlite:///instance/chatbot.db
# Production (MySQL, e.g. via PlanetScale, Railway, or Aiven):
#   mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:///instance/chatbot.db

# OpenAI API key, used for the GPT-3.5-turbo fallback when intent-classification
# confidence is below 0.70. If left blank, the system still runs and falls back
# to a safe "connecting you to a human agent" message instead.
OPENAI_API_KEY=

# Password for the default admin account created by data/seed_knowledge_base.py
ADMIN_PASSWORD=ChangeMe123!
